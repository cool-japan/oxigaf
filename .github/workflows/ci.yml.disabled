name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1

jobs:
  check:
    name: Format & Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - run: cargo fmt --all -- --check
      - run: cargo clippy --workspace --all-targets -- -D warnings

  test:
    name: Test (CPU)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable

      # Mesa llvmpipe for wgpu software rendering
      - name: Install Mesa drivers
        run: |
          sudo apt-get update
          sudo apt-get install -y mesa-vulkan-drivers mesa-utils libgl1-mesa-dri

      - name: Run tests
        env:
          WGPU_BACKEND: gl
        run: cargo test --workspace
